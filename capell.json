{
    "manifest-version": 3,
    "name": "capell-app/navigation",
    "slug": "navigation",
    "displayName": "Navigation",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "shipped",
    "description": "Build site menus by dragging, per site and language, with visitor-group links, scheduled publishing and a change preview.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\Navigation",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": ["capell-app/theme-foundation"],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\Navigation\\Providers\\NavigationServiceProvider",
            "Capell\\Navigation\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": ["Capell\\Navigation\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\Navigation\\Providers\\NavigationServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Navigation\\Manifest\\NavigationAdminResourceContribution",
            "resourceClass": "Capell\\Navigation\\Filament\\Resources\\Navigations\\NavigationResource"
        },
        {
            "type": "schema-extender",
            "class": "Capell\\Navigation\\Manifest\\NavigationSchemaExtendersContribution",
            "extenderClasses": [
                "Capell\\Navigation\\Filament\\Extenders\\NavigationPageSchemaExtender",
                "Capell\\Navigation\\Filament\\Extenders\\NavigationSiteExtender"
            ]
        },
        {
            "type": "configurator",
            "class": "Capell\\Navigation\\Manifest\\NavigationConfiguratorContribution",
            "configuratorClasses": [
                "Capell\\Navigation\\Filament\\Configurators\\Navigations\\DefaultNavigationConfigurator"
            ]
        },
        {
            "type": "page-type",
            "class": "Capell\\Navigation\\Manifest\\NavigationPageTypeContribution",
            "name": "navigation",
            "modelClass": "Capell\\Navigation\\Models\\Navigation"
        },
        {
            "type": "model",
            "class": "Capell\\Navigation\\Manifest\\NavigationModelsContribution",
            "modelClass": "Capell\\Navigation\\Models\\Navigation"
        },
        {
            "type": "migration",
            "class": "Capell\\Navigation\\Manifest\\NavigationMigrationsContribution",
            "tables": ["navigations", "navigation_page_references"],
            "migrationFiles": [
                "2026_05_10_190860_01_create_navigations_table",
                "2026_06_04_000001_create_navigation_page_references_table",
                "2026_08_28_000003_change_navigation_visibility_to_datetime",
                "2026_11_14_000001_scope_navigation_key_uniqueness_to_active_menus"
            ]
        },
        {
            "type": "frontend-component",
            "class": "Capell\\Navigation\\Manifest\\NavigationFrontendComponentsContribution",
            "componentClasses": [
                "Capell\\Navigation\\View\\Components\\Menu",
                "Capell\\Navigation\\View\\Components\\Breadcrumbs",
                "Capell\\Navigation\\View\\Components\\Header\\MainNavigation"
            ]
        },
        {
            "type": "configurator",
            "class": "Capell\\Navigation\\Manifest\\NavigationFrontendRuntimeContribution",
            "contributorClass": "Capell\\Navigation\\Support\\NavigationFrontendRuntimeManifestContributor"
        },
        {
            "type": "render-hook",
            "class": "Capell\\Navigation\\Manifest\\NavigationRenderHookContribution",
            "hookClass": "Capell\\Navigation\\Support\\RenderHooks\\RegisterFoundationHeaderNavigationHook",
            "location": "headerAfter",
            "keys": [
                "foundation-header-navigation-default",
                "foundation-header-navigation-foundation"
            ],
            "cacheSafe": true
        },
        {
            "type": "configurator",
            "class": "Capell\\Navigation\\Manifest\\NavigationContentGraphContribution",
            "extractorClass": "Capell\\Navigation\\Support\\ContentGraph\\NavigationContentGraphExtractor"
        },
        {
            "type": "console-command",
            "class": "Capell\\Navigation\\Manifest\\NavigationConsoleCommandsContribution",
            "commands": [
                "capell:navigation-setup",
                "capell:navigation-demo",
                "capell:navigation:screenshot-fixture"
            ],
            "commandClasses": [
                "Capell\\Navigation\\Console\\Commands\\SetupCommand",
                "Capell\\Navigation\\Console\\Commands\\DemoCommand",
                "Capell\\Navigation\\Console\\Commands\\SeedNavigationScreenshotFixtureCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\Navigation\\Manifest\\NavigationHealthContribution",
            "checkClass": "Capell\\Navigation\\Health\\NavigationHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["navigations", "navigation_page_references"]
    },
    "commands": {
        "install": null,
        "setup": "capell:navigation-setup",
        "setupParams": ["sites"],
        "demo": "capell:navigation-demo",
        "doctor": null,
        "screenshotFixture": "capell:navigation:screenshot-fixture"
    },
    "settings": [],
    "permissions": [
        "ViewAny:Navigation",
        "View:Navigation",
        "Create:Navigation",
        "Update:Navigation",
        "Delete:Navigation",
        "DeleteAny:Navigation",
        "Restore:Navigation",
        "RestoreAny:Navigation",
        "ForceDelete:Navigation",
        "ForceDeleteAny:Navigation",
        "Reorder:Navigation"
    ],
    "capabilities": ["frontend-rendering"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:Navigation",
                "View:Navigation",
                "Create:Navigation",
                "Update:Navigation",
                "Delete:Navigation",
                "DeleteAny:Navigation",
                "Restore:Navigation",
                "RestoreAny:Navigation",
                "ForceDelete:Navigation",
                "ForceDeleteAny:Navigation",
                "Reorder:Navigation"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["navigation"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["page"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Navigation\\Models\\Navigation",
                    "events": ["saved", "deleted", "restored"]
                },
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["updated"]
                },
                {
                    "model": "Capell\\Core\\Models\\Site",
                    "events": ["replicated"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "navigation.package-health",
            "label": "Navigation package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\Navigation\\Health\\NavigationHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Drag-and-drop header, footer and sub-footer menus per site and language, with audience rules, publish dates and site-copy support.",
        "description": "Build header, footer and sub-footer menus without code. Nest items, link to pages or addresses, add headings, choose dropdown or wide layouts and set when each menu goes live. Show links to guests, signed-in visitors or roles, check what a change affects first, and carry menus across when a site is copied.",
        "problem": "Editors lose track of menu links and their order across sites and languages.",
        "outcome": "Each site and language gets its own menu, ready to publish on a date.",
        "faq": [
            {
                "question": "Can the Welsh menu differ from the English one?",
                "answer": "Yes. A menu can be set to a language. If no menu exists for a language, the menu with no language set is used."
            },
            {
                "question": "If I hide a menu link from guests, is the page protected?",
                "answer": "No. Anyone who has the address can still open the page, because hiding only removes the link from the menu. Protect the page itself separately."
            },
            {
                "question": "Will a menu I add appear on my site by itself?",
                "answer": "Not always. The Foundation theme shows the three built-in menus, and a menu you create shows only where a theme or layout widget asks for it by name."
            },
            {
                "question": "Can I publish a menu on a later date?",
                "answer": "Yes. A menu can be published at once or on a date you choose."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card titled Navigation with an empty Create Navigation form, light and dark, beside Link, Nest and Render.",
                "caption": "The Marketplace card for Navigation, the menu builder for each site and language."
            },
            {
                "path": "docs/screenshots/frontend-menu-output.png",
                "alt": "Public home page of an example consultancy with a header menu of Work, Field notes, Approach and Contact, and a footer menu.",
                "caption": "Header and footer menus as visitors see them on the public site.",
                "required": true
            }
        ],
        "categories": ["admin", "console", "foundation", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "admin-resource",
                "key": "resource:Navigation:default",
                "providerBucket": "runtime"
            },
            {
                "type": "model",
                "key": "model:Capell\\Navigation\\Models\\Navigation",
                "providerBucket": "runtime"
            },
            {
                "type": "configurator",
                "key": "configurator:Navigations:Default",
                "providerBucket": "runtime"
            },
            {
                "type": "render-hook",
                "key": "foundation-header-navigation-default",
                "providerBucket": "runtime"
            },
            {
                "type": "render-hook",
                "key": "foundation-header-navigation-foundation",
                "providerBucket": "runtime"
            }
        ]
    }
}
