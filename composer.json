{
    "name": "capell-app/navigation",
    "description": "Drag-and-drop site menus for Capell, per site and language, with audience rules, publish dates and site-copy support.",
    "keywords": [
        "capell",
        "navigation",
        "laravel",
        "filamentphp",
        "cms"
    ],
    "homepage": "https://github.com/capell-app/navigation",
    "license": "proprietary",
    "authors": [
        {
            "name": "Howdu",
            "email": "capell.app26@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.79",
        "capell-app/core": "^1.0.79",
        "capell-app/frontend": "^1.0.79"
    },
    "suggest": {
        "capell-app/theme-foundation": "Provides the dropdown that renders header menu children."
    },
    "autoload": {
        "psr-4": {
            "Capell\\Navigation\\": "src/",
            "Capell\\Navigation\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\Navigation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\Navigation\\Providers\\NavigationServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/navigation"
    }
}
